{
  // The public site, served as Worker static assets. Nothing is built here on purpose: the factory
  // builds the site and this script publishes the result.
  "name": "babyrock-site",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./docs",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
